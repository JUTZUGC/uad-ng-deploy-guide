    "deploy": {
      "type": "binary",
      "steps": [
        "curl -fL -o uad-ng https://github.com/Universal-Debloater-Alliance/universal-android-debloater-next-generation/releases/latest/download/uad-ng-linux",
        "chmod +x uad-ng",
        "./uad-ng"
      ],
      "stepsPs": [
        "curl.exe -fL -o uad-ng-windows.exe https://github.com/Universal-Debloater-Alliance/universal-android-debloater-next-generation/releases/latest/download/uad-ng-windows.exe",
        "Get-Item uad-ng-windows.exe | Select-Object Name, Length",
        "Start-Process .\\uad-ng-windows.exe"
      ],
      "source": "https://github.com/Universal-Debloater-Alliance/universal-android-debloater-next-generation/wiki/Getting-started"
    },
    "pitfalls": [
      "列表空白：确认 USB 调试已开且手机已授权本机",
      "识别不到设备：换数据线，或在开发者选项里切换 USB 配置",
      "卸载后手机异常：用 `adb install-existing` 恢复，恢复不了只能刷机",
      "误删关键包：只动标为 Recommended 的条目",
      "macOS 打不开：在隐私与安全性里允许运行",
      "CLI 权限不足：`chmod +x` 后再执行",
      "列表更新失败：检查能否访问 GitHub"
    ]
  },
  "gate": {
    "allow": [
      "dumate"
